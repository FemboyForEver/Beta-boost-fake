-- ========= REBIND SYSTEM (MANETTE & PC) =========
local waitingBind = nil
local rebindButtons = {}

local function startBind(action)
	waitingBind = action
	Rayfield:Notify({
		Title = "Rebind",
		Content = "Appuie sur une touche (Clavier ou Manette)",
		Duration = 3
	})
end

-- Fonctions utilitaires pour afficher proprement les touches combinées
local function getBindText(action, keyGamepad, keyPC)
	return "Changer " .. action .. " (" .. keyGamepad.Name .. " / " .. keyPC.Name .. ")"
end

rebindButtons.boost = BoostPage:CreateButton({
	Name = getBindText("Boost", binds.boost, binds.pc_boost),
	Callback = function() startBind("boost") end
})

rebindButtons.brake = BrakePage:CreateButton({
	Name = getBindText("Frein", binds.brake, binds.pc_brake),
	Callback = function() startBind("brake") end
})

rebindButtons.stop = BrakePage:CreateButton({
	Name = getBindText("Stop", binds.stop, binds.pc_stop),
	Callback = function() startBind("stop") end
})

rebindButtons.jump = JumpPage:CreateButton({
	Name = getBindText("Jump", binds.jump, binds.pc_jump),
	Callback = function() startBind("jump") end
})

rebindButtons.accel = SpeedPage:CreateButton({
	Name = getBindText("Accélération", binds.accel, binds.pc_accel),
	Callback = function() startBind("accel") end
})

-- ========= INPUTS (MANETTE & PC) =========
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	-- Logique du Rebind automatique (détecte si c'est clavier ou manette)
	if waitingBind then
		if input.UserInputType == Enum.UserInputType.Gamepad1 then
			binds[waitingBind] = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.Keyboard then
			binds["pc_" .. waitingBind] = input.KeyCode
		else
			return
		end
		
		-- Rafraîchissement du texte du bouton
		if rebindButtons[waitingBind] then
			local cleanName = waitingBind:sub(1,1):upper() .. waitingBind:sub(2)
			rebindButtons[waitingBind]:Set(getBindText(cleanName, binds[waitingBind], binds["pc_" .. waitingBind]))
		end
		waitingBind = nil
		Rayfield:Notify({Title="Rebind", Content="Touche configurée !", Duration=2})
		return
	end

	-- Détection des touches Manette OU Clavier
	local isGamepad = (input.UserInputType == Enum.UserInputType.Gamepad1)
	local isKeyboard = (input.UserInputType == Enum.UserInputType.Keyboard)

	if (isGamepad and input.KeyCode == binds.boost) or (isKeyboard and input.KeyCode == binds.pc_boost) then 
		Boost()
	elseif (isGamepad and input.KeyCode == binds.accel) or (isKeyboard and input.KeyCode == binds.pc_accel) then 
		accelerating = true
	elseif (isGamepad and input.KeyCode == binds.brake) or (isKeyboard and input.KeyCode == binds.pc_brake) then 
		Brake()
	elseif (isGamepad and input.KeyCode == binds.stop) or (isKeyboard and input.KeyCode == binds.pc_stop) then 
		Stop()
	elseif (isGamepad and input.KeyCode == binds.jump) or (isKeyboard and input.KeyCode == binds.pc_jump) then 
		Jump()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local isGamepad = (input.UserInputType == Enum.UserInputType.Gamepad1)
	local isKeyboard = (input.UserInputType == Enum.UserInputType.Keyboard)

	if (isGamepad and input.KeyCode == binds.accel) or (isKeyboard and input.KeyCode == binds.pc_accel) then 
		accelerating = false 
	end
end)

-- ========= BOOST DIRECTIONNEL (CAMERA FLY BOOST + LIFT) =========

-- CONFIG
local flyBoostPower = 180
local flyBoosting = false
local keepVehicleUpright = true
local liftForce = 65 
local originalPhysicalProps = nil

-- CAMERA
local Camera = workspace.CurrentCamera

-- STABILISATION
local flyGyro = nil

local function StartFlyBoost()
	local seat = GetSeat()
	if not seat or not seat:IsA("VehicleSeat") then return end

	flyBoosting = true

	if not originalPhysicalProps then
		originalPhysicalProps = seat.CustomPhysicalProperties
	end

	if originalPhysicalProps then
		seat.CustomPhysicalProperties = PhysicalProperties.new(
			originalPhysicalProps.Density,
			0, 
			originalPhysicalProps.Elasticity,
			originalPhysicalProps.FrictionWeight,
			originalPhysicalProps.ElasticityWeight
		)
	end

	if keepVehicleUpright and not flyGyro then
		flyGyro = Instance.new("BodyGyro")
		flyGyro.MaxTorque = Vector3.new(1e7,1e7,1e7)
		flyGyro.P = 6000
		flyGyro.D = 400
		flyGyro.CFrame = CFrame.new(seat.Position) * CFrame.Angles(0, math.rad(seat.Orientation.Y), 0)
		flyGyro.Parent = seat
	end

	seat.AssemblyLinearVelocity += Vector3.new(0, liftForce, 0)
end

local function StopFlyBoost()
	flyBoosting = false

	local seat = GetSeat()
	if seat and originalPhysicalProps then
		seat.CustomPhysicalProperties = originalPhysicalProps
	end

	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
end

-- APPLICATION DU BOOST DIRECTIONNEL
RunService.Heartbeat:Connect(function(dt)
	if not flyBoosting then return end

	local seat = GetSeat()
	if not seat or not seat:IsA("VehicleSeat") then return end

	local camDir = Camera.CFrame.LookVector
	seat.AssemblyLinearVelocity += camDir * flyBoostPower * dt
	seat.AssemblyLinearVelocity += Vector3.new(0, liftForce * 0.15 * dt, 0)

	if keepVehicleUpright and flyGyro then
		flyGyro.CFrame = CFrame.new(seat.Position) * CFrame.Angles(0, math.rad(seat.Orientation.Y), 0)
	end
end)

