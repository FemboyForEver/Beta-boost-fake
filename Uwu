-- 🚗 Menu by Shido (Rayfield Adaptation v2 - PC & Gamepad)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ========= CONFIG =========
local velocityMult = 0.5 -- puissance boost basique
local velocityMult2 = 0.4 -- puissance frein
local jumpPower = 50      -- puissance saut
local maxMPH = 1000        -- vitesse max pour speed changer
local accelerationMPH = 300 -- accélération MPH/s

-- Conversion MPH -> studs/s
local function MPHtoStuds(mph)
	return mph / 0.626
end

-- ========= BINDS (MANETTE & CLAVIER) =========
local binds = {
	-- Manette
	boost = Enum.KeyCode.ButtonA,
	accel = Enum.KeyCode.ButtonR2,
	brake = Enum.KeyCode.ButtonB,
	stop  = Enum.KeyCode.ButtonX,
	jump  = Enum.KeyCode.ButtonY,
	flyBoost = Enum.KeyCode.ButtonL1,
	
	-- Clavier (PC)
	pc_boost = Enum.KeyCode.LeftShift,
	pc_accel = Enum.KeyCode.Z,
	pc_brake = Enum.KeyCode.S,
	pc_stop  = Enum.KeyCode.X,
	pc_jump  = Enum.KeyCode.Space,
	pc_flyBoost = Enum.KeyCode.A
}

-- ========= FONCTIONS =========
local function GetSeat()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildWhichIsA("Humanoid")
	if hum then return hum.SeatPart end
end

-- 🔹 BOOST BASIQUE (A / Shift)
local function Boost()
	local seat = GetSeat()
	if seat and seat:IsA("VehicleSeat") then
		seat.AssemblyLinearVelocity += seat.CFrame.LookVector * (velocityMult * 120)
	end
end

-- 🔹 FREIN / STOP / JUMP
local accelerating = false

local function Brake()
	accelerating = false
	local seat = GetSeat()
	if seat and seat:IsA("VehicleSeat") then
		seat.AssemblyLinearVelocity *= (1 - velocityMult2)
	end
end

local function Stop()
	accelerating = false
	local seat = GetSeat()
	if seat and seat:IsA("VehicleSeat") then
		seat.AssemblyLinearVelocity = Vector3.zero
		seat.AssemblyAngularVelocity = Vector3.zero
	end
end

local function Jump()
	local seat = GetSeat()
	if seat and seat:IsA("VehicleSeat") then
		seat.AssemblyLinearVelocity += Vector3.new(0, jumpPower, 0)
	end
end

-- 🔹 ACCÉLÉRATION PROGRESSIVE / SPEED CHANGER
local realisticMode = false

RunService.Heartbeat:Connect(function(dt)
	local seat = GetSeat()
	if not seat or not seat:IsA("VehicleSeat") then return end

	if accelerating then
		if realisticMode then
			local forward = seat.CFrame.LookVector
			local vel = seat.AssemblyLinearVelocity
			seat.AssemblyLinearVelocity = vel + forward * (accelerationMPH * dt / 2)
		else
			local targetSpeed = MPHtoStuds(maxMPH)
			local accelStuds = MPHtoStuds(accelerationMPH)
			local forward = seat.CFrame.LookVector
			local vel = seat.AssemblyLinearVelocity
			local currentSpeed = vel:Dot(forward)
			local newSpeed = math.min(currentSpeed + accelStuds * dt, targetSpeed)
			seat.AssemblyLinearVelocity = Vector3.new(
				forward.X * newSpeed,
				vel.Y,
				forward.Z * newSpeed
			)
		end
	end
end)

