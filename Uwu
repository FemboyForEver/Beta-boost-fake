-- ========= EXTENSION : VÉHICULE NOCLIP (PASSE-MURAILLE) =========

-- CONFIG
local noclipEnabled = false
local PhysicsService = game:GetService("PhysicsService")

-- S'assurer que le groupe de collision existe (nom unique pour éviter les conflits)
local groupName = "ShidoNoclipGroup"
pcall(function()
	PhysicsService:RegisterCollisionGroup(groupName)
	-- Désactive les collisions entre ce groupe et la map/décors (Default)
	PhysicsService:CollisionGroupSetCollidable(groupName, "Default", false)
end)

-- Fonction pour appliquer ou retirer le noclip sur le véhicule
local function SetVehicleNoclip(state)
	local seat = GetSeat()
	if not seat then return end
	
	-- On récupère le modèle complet de la voiture
	local vehicleModel = seat:FindFirstAncestorOfClass("Model") or seat.Parent
	if not vehicleModel then return end

	-- On applique le groupe de collision à toutes les pièces du véhicule
	for _, part in ipairs(vehicleModel:GetDescendants()) do
		if part:IsA("BasePart") then
			-- Sécurité : On ne touche pas au joueur assis dedans
			if not part:IsAncestorOf(LocalPlayer.Character) then
				if state then
					part.CollisionGroup = groupName
				else
					part.CollisionGroup = "Default"
				end
			end
		end
	end
end

-- Relancer le noclip automatiquement si on change de véhicule ou si la physique se reset
RunService.Heartbeat:Connect(function()
	if noclipEnabled then
		SetVehicleNoclip(true)
	end
end)

