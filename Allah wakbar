-- ========= EXTENSION : MODE BÉLIER PHYSIQUE (IMPACT FLING) =========

local ramImpactEnabled = false
local ramConnection = nil
local ramPower = 150 -- Puissance de la projection (Augmente si tu veux les envoyer sur la Lune)

local function applyRamImpact()
	local mySeat = GetSeat()
	if not mySeat or not mySeat:IsA("VehicleSeat") then return end

	local myVehicle = mySeat:FindFirstAncestorOfClass("Model") or mySeat.Parent
	if not myVehicle then return end

	-- On cherche les autres véhicules à proximité
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("VehicleSeat") and obj ~= mySeat then
			local otherVehicle = obj:FindFirstAncestorOfClass("Model") or obj.Parent
			
			if otherVehicle and obj.PrimaryPart then
				-- Calcul de la distance entre ma voiture et l'autre
				local distance = (mySeat.Position - obj.Position).Magnitude
				
				-- Si l'autre voiture est à moins de 12 studs (zone d'impact / collision)
				if distance <= 12 then
					-- On cible toutes les pièces physiques de l'autre voiture
					for _, part in ipairs(otherVehicle:GetDescendants()) do
						if part:IsA("BasePart") and not part.Anchored then
							-- On applique une impulsion physique violente (vitesse + rotation)
							part.Velocity = Vector3.new(math.random(-ramPower, ramPower), ramPower * 1.5, math.random(-ramPower, ramPower))
							part.RotVelocity = Vector3.new(ramPower, ramPower, ramPower)
						end
					end
				end
			end
		end
	end
end

