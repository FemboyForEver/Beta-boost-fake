	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(char) onCharacterAdded(char, player) end)
	player.CharacterRemoving:Connect(onCharacterRemoving)
	if player.Character then onCharacterAdded(player.Character, player) end
end)

Players.PlayerRemoving:Connect(function(player)
	if player.Character then cleanupESP(player.Character) end
end)

RunService.Heartbeat:Connect(function()
	for character, data in pairs(State.TrackedCharacters) do
		if character and character.Parent then
			updateVisual(character)
		else
			cleanupESP(character)
