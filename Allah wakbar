-- ========= RECONSTRUCTION : SYSTEME NOCLIP TOTAL (VÉHICULE + JOUEUR) =========

local wallNoclipEnabled = false
local noclipConnection = nil
local originalCollides = {}

-- Fonction pour passer en noclip le véhicule ET le joueur
local function applyTotalNoclip()
	-- 1. Noclip du Véhicule
	local seat = GetSeat()
	if seat and seat:IsA("VehicleSeat") then
		local vehicleModel = seat:FindFirstAncestorOfClass("Model") or seat.Parent
		if vehicleModel then
			for _, part in ipairs(vehicleModel:GetDescendants()) do
				if part:IsA("BasePart") then
					-- On ignore les pièces du joueur ici pour les traiter juste après
					if not part:IsAncestorOf(LocalPlayer.Character) then
						if originalCollides[part] == nil then
							originalCollides[part] = part.CanCollide
						end
						part.CanCollide = false
					end
				end
			end
		end
		-- Sécurité pour maintenir le moteur de conduite actif
		seat.CanCollide = false
	end

	-- 2. Noclip du Joueur (Évite l'éjection à travers les structures)
	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if originalCollides[part] == nil then
					originalCollides[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end
end

-- Restauration complète des collisions d'origine
local function disableTotalNoclip()
	for part, originalState in pairs(originalCollides) do
		if part and part.Parent then
			part.CanCollide = originalState
		end
	end
	originalCollides = {}
end

